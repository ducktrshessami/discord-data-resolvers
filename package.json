{
    "name": "discord-data-resolvers",
    "version": "0.4.0",
    "description": "Standalone type-safe interaction data parsing utilities",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.cts",
    "repository": "git@github.com:ducktrshessami/discord-data-resolvers.git",
    "author": "ducktrshessami",
    "license": "MIT",
    "scripts": {
        "prebuild": "tsc --noEmit",
        "build": "tsdown",
        "pretest": "yarn build && tsc --project tsconfig.test.json",
        "test": "vitest"
    },
    "exports": {
        "types": "./dist/index.d.cts",
        "require": "./dist/index.cjs",
        "import": "./dist/index.mjs"
    },
    "dependencies": {
        "discord-api-types": "^0.38.52"
    },
    "devDependencies": {
        "tsdown": "^0.22.14",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
